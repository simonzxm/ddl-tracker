{
  "name": "@ddl-tracker/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "wrangler deploy --dry-run --outdir dist",
    "db:generate": "drizzle-kit generate --config=drizzle.config.mjs && node ../../scripts/generate-migration-bundle.mjs",
    "db:migrate": "drizzle-kit migrate --config=drizzle.config.mjs",
    "dev": "wrangler dev",
    "typecheck": "tsc -b --pretty false",
    "types:worker": "wrangler types --env-interface Env --strict-vars false"
  },
  "dependencies": {
    "@ddl-tracker/catalog-sync": "workspace:*",
    "@ddl-tracker/contracts": "workspace:*",
    "@hono/zod-openapi": "1.5.1",
    "drizzle-orm": "0.45.2",
    "hono": "4.12.31",
    "jose": "^6.2.5",
    "pg": "8.22.0",
    "zod": "4.4.3"
  }
}
