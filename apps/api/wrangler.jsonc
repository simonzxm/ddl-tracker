{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "ddl-tracker-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-19",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "triggers": {
    "crons": [
      "17 3 * * *"
    ]
  },
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "00000000000000000000000000000000"
    }
  ],
  "vars": {
    "APP_ENVIRONMENT": "development",
    "OIDC_ISSUER": "https://auth.nju.at",
    "OIDC_CLIENT_ID": "6VdLQ24XWMDAr-ckY_A9JlmTXk0JchLo",
    "OIDC_REDIRECT_URI": "https://ddl.nju.at/api/v1/auth/oidc/callback",
    "OIDC_POST_LOGIN_REDIRECT_URIS": "https://ddl.nju.at/auth/callback/web,https://ddl.nju.at/auth/callback/native,ddltracker.mac://auth/callback"
  },
  "services": [
    {
      "binding": "AUTH_SERVER",
      "service": "authserver",
      "remote": true
    }
  ]
}
