{
  "name": "ddl-tracker",
  "private": true,
  "version": "0.0.0",
  "packageManager": "pnpm@11.15.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "pnpm -r build",
    "check": "pnpm lint && pnpm typecheck && pnpm test",
    "deploy:check": "node scripts/validate-production-config.mjs",
    "lint": "eslint .",
    "smoke": "node scripts/smoke.mjs",
    "test": "vitest run",
    "test:postgres": "node scripts/test-postgres.mjs",
    "test:worker": "vitest run --config vitest.worker.config.mts",
    "test:postgres:docker": "sh scripts/test-postgres-docker.sh",
    "test:watch": "vitest",
    "typecheck": "tsc -b --pretty false && tsc -p tsconfig.tests.json --pretty false",
    "verify": "pnpm verify:generated && pnpm lint && pnpm typecheck && pnpm test:postgres:docker && pnpm test:worker && pnpm build",
    "verify:ci": "pnpm verify:generated && pnpm lint && pnpm typecheck && pnpm test:postgres && pnpm test:worker && pnpm build",
    "verify:generated": "node scripts/verify-generated.mjs",
    "ios:contracts": "node scripts/update-ios-contracts.mjs",
    "ios:contracts:check": "node scripts/update-ios-contracts.mjs --check",
    "ios:test": "swift test --package-path apps/ios",
    "ios:project": "cd apps/ios && xcodegen generate"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "0.18.6",
    "@eslint/js": "10.0.1",
    "@types/node": "24.13.3",
    "@types/pg": "8.20.0",
    "@vitest/coverage-v8": "4.1.10",
    "drizzle-kit": "0.31.10",
    "eslint": "10.7.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.64.0",
    "vitest": "4.1.10",
    "wrangler": "4.112.0"
  }
}
